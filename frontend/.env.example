# LINE AI Secretary - Frontend Environment Variables
# Copy to .env.local and fill in actual values

# --- API ---
# Backend API base URL
VITE_API_URL=http://localhost:8293

# --- LINE Login ---
# LINE Login channel ID (from LINE Developers Console)
VITE_LINE_LOGIN_CHANNEL_ID=
# Redirect URI after LINE Login (must match LINE console setting)
VITE_LINE_LOGIN_REDIRECT_URI=http://localhost:3847/callback
