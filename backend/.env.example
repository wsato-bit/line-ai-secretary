# LINE AI Secretary - Backend Environment Variables
# Copy to .env.local and fill in actual values

# --- Server ---
HOST=0.0.0.0
PORT=8293

# --- Database (Neon PostgreSQL) ---
# Format: postgresql+asyncpg://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Redis (Upstash) ---
# Format: rediss://default:password@host:port
REDIS_URL=

# --- AI ---
# Anthropic API key for Claude
ANTHROPIC_API_KEY=

# --- LINE Messaging API ---
# From LINE Developers Console > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- LINE Login ---
# From LINE Developers Console > LINE Login channel
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# --- Google Cloud ---
# Path to service account JSON key file (local dev only; use workload identity on Cloud Run)
GOOGLE_APPLICATION_CREDENTIALS=
# GCS bucket for file uploads
GCS_BUCKET_NAME=

# --- Security ---
# 32-byte hex key for AES-256 encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
ENCRYPTION_KEY=

# --- Scheduler ---
# Shared secret for authenticating Cloud Scheduler requests
JOB_AUTH_SECRET=

# --- CORS ---
# Frontend URL for CORS allow-origin
FRONTEND_URL=http://localhost:3847
